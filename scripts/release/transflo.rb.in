# typed: strict
# frozen_string_literal: true

# Homebrew cask for the Ali-Fayed/homebrew-transflo tap. Generated by scripts/release.sh.
cask "transflo" do
  version "@VERSION@"
  sha256 "@SHA256@"

  url "https://github.com/Ali-Fayed/transflo/releases/download/v#{version}/Transflo-#{version}-arm64.dmg"
  name "Transflo"
  desc "Convert, edit and act on files from a radial wheel at your cursor"
  homepage "https://transfloformac.ali-fayed.com"

  depends_on arch: :arm64
  depends_on macos: :sonoma

  app "Transflo.app"

  zap trash: [
    "~/Library/Caches/com.transflo.app",
    "~/Library/Preferences/com.transflo.app.plist",
    "~/Library/Saved Application State/com.transflo.app.savedState",
  ]
@CAVEATS@end
